    "runnerSource": "\"\"\"Frozen numeric-only test boundary; not an independent OS principal or AI09.\"\"\"\nimport ast, hashlib, json, pathlib, sys\nraw=pathlib.Path(sys.argv[1]).read_bytes();cases_raw=pathlib.Path(sys.argv[2]).read_bytes()\nassert len(raw)<=8192 and len(cases_raw)<=65536\ntree=ast.parse(raw.decode('utf-8'));nodes=list(ast.walk(tree))\nassert len(nodes)<=180 and len(tree.body)==1 and isinstance(tree.body[0],ast.FunctionDef)\nassert sum(isinstance(n,ast.FunctionDef) for n in nodes)==1\nf=tree.body[0];a=f.args\nassert f.name=='clamp' and not f.decorator_list and f.returns is None and not getattr(f,'type_params',[])\nassert [x.arg for x in a.args]==['value','lower','upper']\nassert not a.posonlyargs and not a.kwonlyargs and not a.vararg and not a.kwarg and not a.defaults and not a.kw_defaults\nallowed=(ast.Module,ast.FunctionDef,ast.arguments,ast.arg,ast.Return,ast.If,ast.IfExp,ast.Compare,ast.BoolOp,ast.And,ast.Or,ast.Name,ast.Load,ast.Store,ast.Assign,ast.Tuple,ast.Constant,ast.UnaryOp,ast.USub,ast.UAdd,ast.Lt,ast.LtE,ast.Gt,ast.GtE,ast.Eq,ast.NotEq,ast.Call)\nfor n in nodes:\n assert isinstance(n,allowed),'AST_NODE_NOT_ALLOWED:'+type(n).__name__\n if isinstance(n,ast.arg):assert n.annotation is None\n if isinstance(n,ast.Name):assert n.id in {'value','lower','upper','lo','hi','min','max'}\n if isinstance(n,ast.Call):assert isinstance(n.func,ast.Name) and n.func.id in {'min','max'} and 1<=len(n.args)<=3 and not n.keywords\n if isinstance(n,ast.Constant):assert type(n.value) is int and abs(n.value)<=1000000\nnamespace={'__builtins__':{'min':min,'max':max}}\nexec(compile(tree,'<bounded-numeric-candidate>','exec'),namespace)\ncases=json.loads(cases_raw);assert type(cases) is list and 1<=len(cases)<=256\nfailures=[]\nfor value,lower,upper in cases:\n assert all(type(x) is int and abs(x)<=1000000 for x in [value,lower,upper])\n expected=min(max(value,min(lower,upper)),max(lower,upper));actual=namespace['clamp'](value,lower,upper)\n if type(actual) is not int or actual!=expected:\n  failures.append({'input':[value,lower,upper],'expected':expected,'actual':actual if type(actual) is int else {'invalidReturnType':type(actual).__name__}})\nprint(json.dumps({'sourceSha256':hashlib.sha256(raw).hexdigest(),'testCasesSha256':hashlib.sha256(cases_raw).hexdigest(),'testCount':len(cases),'failCount':len(failures),'failures':failures,'boundary':'numeric AST, isolated Python -I -S child; no independent principal','python':sys.version.split()[0]}))\nsys.exit(1 if failures else 0)\n",
